# =========================================================
# Shared Database
# =========================================================

DB_USERNAME=fintech_user
DB_PASSWORD=change-me

IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
LEDGER_DB_URL=jdbc:postgresql://localhost:5432/ledger_db
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db


# =========================================================
# Service Ports
# =========================================================

API_GATEWAY_PORT=8081
IDENTITY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
LEDGER_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085


# =========================================================
# Gateway Service URLs
# =========================================================

IDENTITY_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
LEDGER_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085


# =========================================================
# JWT
# =========================================================

JWT_SECRET=replace-with-a-local-secret-at-least-32-bytes
JWT_EXPIRATION=3600000


# =========================================================
# Kafka
# =========================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

PAYMENT_KAFKA_GROUP_ID=payment-service-group
LEDGER_KAFKA_GROUP_ID=ledger-service-group
NOTIFICATION_KAFKA_GROUP_ID=notification-service-group

KAFKA_PRODUCER_RETRIES=3


# =========================================================
# Kafka Topics
# =========================================================

PAYMENTS_CREATED_TOPIC=payments.created
PAYMENTS_CREATED_DLT_TOPIC=payments.created.DLT

LEDGER_COMPLETED_TOPIC=ledger.completed
LEDGER_FAILED_TOPIC=ledger.failed

PAYMENTS_COMPLETED_TOPIC=payments.completed
PAYMENTS_FAILED_TOPIC=payments.failed


# =========================================================
# Redis
# =========================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2s


# =========================================================
# Gateway Rate Limiting
# =========================================================

PAYMENT_RATE_LIMIT_REPLENISH_RATE=5
PAYMENT_RATE_LIMIT_BURST_CAPACITY=5


# =========================================================
# Payment Outbox
# =========================================================

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_KAFKA_SEND_TIMEOUT_MS=10000


# =========================================================
# Payment Recovery
# =========================================================

PAYMENT_RECOVERY_ENABLED=true
PAYMENT_PROCESSING_TIMEOUT_MS=300000
PAYMENT_RECOVERY_RETRY_INTERVAL_MS=60000
PAYMENT_RECOVERY_POLL_INTERVAL_MS=30000
PAYMENT_RECOVERY_MAX_ATTEMPTS=3
PAYMENT_RECOVERY_BATCH_SIZE=20


# =========================================================
# Ledger Recovery
# =========================================================

LEDGER_RECOVERY_INTERNAL_KEY=replace-with-local-internal-key

LEDGER_RECOVERY_CONNECT_TIMEOUT_MS=2000
LEDGER_RECOVERY_READ_TIMEOUT_MS=3000


# =========================================================
# Ledger Reconciliation
# =========================================================

LEDGER_RECONCILIATION_ENABLED=true
LEDGER_RECONCILIATION_INTERVAL_MS=300000


# =========================================================
# Ledger Cache
# =========================================================

LEDGER_CACHE_TTL=60s


# =========================================================
# Ledger Result Publishing
# =========================================================

LEDGER_RESULT_MAX_ATTEMPTS=3
LEDGER_RESULT_BACKOFF_MS=500
LEDGER_RESULT_SEND_TIMEOUT_MS=10000


# =========================================================
# Observability
# =========================================================

TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans


# =========================================================
# Grafana
# =========================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me